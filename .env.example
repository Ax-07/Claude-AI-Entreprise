# Secrets — ce fichier reste sur ton PC, il n'est jamais envoyé sur GitHub (.gitignore).

# Fournisseur d'IA : mets AU MOINS UNE de ces deux clés.
# Avec "provider": "auto" dans config.json, Anthropic est utilisé si sa clé est présente, sinon OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optionnel : autre point d'accès compatible OpenAI (laisser vide pour api.openai.com)
OPENAI_BASE_URL=

# Recherche web (recommandé) : Brave Search API (api-dashboard.search.brave.com, offre Search)
BRAVE_API_KEY=

# Optionnel : Stripe. Conseil : crée une clé « restreinte » (Stripe > Développeurs > Clés API)
# avec lecture sur Balance, Charges et Checkout Sessions, écriture sur Prices, Products et Payment Links uniquement.
# Les ventes sont lues toutes les 10 minutes et affichées dans le tableau de bord.
STRIPE_SECRET_KEY=

# Emails : envoi (après ta validation) et lecture des réponses. Avec Gmail :
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton.adresse@gmail.com,
#   SMTP_PASSWORD=mot de passe d'application (Compte Google > Sécurité > Validation en deux étapes > Mots de passe des applications).
# La lecture (IMAP) réutilise automatiquement ces identifiants pour Gmail ; IMAP_* sert pour une autre boîte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Optionnel : site public sur GitHub Pages (pages d'offre publiées après ta validation).
# GITHUB_PAGES_REPO=propriétaire/dépôt (dépôt public, Pages activé sur la branche main)
# GITHUB_TOKEN=jeton « fine-grained » limité à ce dépôt, permission Contents en lecture et écriture
GITHUB_PAGES_REPO=
GITHUB_TOKEN=
# Optionnel : adresse du site si elle diffère de https://<propriétaire>.github.io/<dépôt> (nom de domaine plus tard)
SITE_URL=
