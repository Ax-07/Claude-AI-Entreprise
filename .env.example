# Secrets — ce fichier reste sur ton PC, il n'est jamais envoyé sur GitHub (.gitignore).

# Obligatoire : clé API Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Optionnel : Stripe. Conseil : crée une clé « restreinte » (Stripe > Développeurs > Clés API)
# avec lecture sur Balance et Charges, écriture sur Prices et Payment Links uniquement.
STRIPE_SECRET_KEY=

# Optionnel : envoi d'emails (après ta validation). Exemple avec une boîte pro.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
